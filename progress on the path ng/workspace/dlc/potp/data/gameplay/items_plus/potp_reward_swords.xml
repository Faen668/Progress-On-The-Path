<?xml version="1.0" encoding="UTF-8"?>
<redxml>
<definitions>

<!-- Progress on the Path's reward swords: Pathfinder (steel) and Navigator (silver). Relics in the vanilla pattern:
     Autogen, so the game builds their damage for Geralt's level when they're given (AutogenForceLevel: exactly, no
     random spread), then PotP's scripts keep them at his level (scripts/local/rewards/RewardSwords.ws). -->
<abilities>

	<ability name="PotP_Pathfinder_Stats">
		<weight							type="base"	min="3.9"				/>
		<quality						type="add"	min="4"		max="4"		/>
		<SilverDamage					type="base"	min="1"					/>
		<critical_hit_chance			type="add"	min="0.04"	max="0.06"	/>
		<critical_hit_damage_bonus		type="add"	min="0.10"	max="0.15"	/>
		<spell_power_aard				type="mult"	min="0.05"	max="0.08"	/>
		<desc_bleedingchance_mult		type="add"	min="0.08"				/>
		<buff_apply_chance				type="add"	min="0.08"				/>
		<BleedingEffect					is_ability="true"					/>
	</ability>

	<ability name="PotP_Navigator_Stats">
		<weight							type="base"	min="3.4"				/>
		<quality						type="add"	min="4"		max="4"		/>
		<SlashingDamage					type="base"	min="1"					/>
		<spell_power_quen				type="mult"	min="0.05"	max="0.08"	/>
		<spell_power_yrden				type="mult"	min="0.05"	max="0.08"	/>
		<critical_hit_damage_bonus		type="add"	min="0.10"	max="0.15"	/>
		<nonhuman_exp_bonus_when_fatal	type="add"	min="0.02"	max="0.03"	/>
		<desc_freezingchance_mult		type="add"	min="0.06"				/>
		<buff_apply_chance				type="add"	min="0.06"				/>
		<SlowdownFrostEffect			is_ability="true"					/>
	</ability>

	<!-- Growth: one of these per level above 1 (to level 50), added and taken away by PotP's scaler as Geralt levels, so
	     the perks keep pace as the damage does. The vanilla ones reach about a vanilla Grandmaster witcher sword at
	     level 40 (its +11% crit chance, bleeding and Sign intensity); the EWR ones, used when The Essential Weapon
	     Rework is installed, about its Grandmaster swords (+45% attack power, +50% Sign intensity, +75% crit damage). -->
	<ability name="PotP_Pathfinder_Growth">
		<critical_hit_chance			type="add"	min="0.0016"			/>
		<critical_hit_damage_bonus		type="add"	min="0.0035"			/>
		<spell_power_aard				type="mult"	min="0.0037"			/>
		<desc_bleedingchance_mult		type="add"	min="0.001"				/>
		<buff_apply_chance				type="add"	min="0.001"				/>
	</ability>

	<ability name="PotP_Pathfinder_Growth_EWR">
		<attack_power					type="mult"	min="0.0105"			/>
		<critical_hit_chance			type="add"	min="0.0022"			/>
		<critical_hit_damage_bonus		type="add"	min="0.016"				/>
		<spell_power_aard				type="mult"	min="0.0115"			/>
		<desc_bleedingchance_mult		type="add"	min="0.003"				/>
		<buff_apply_chance				type="add"	min="0.003"				/>
	</ability>

	<ability name="PotP_Navigator_Growth">
		<spell_power_quen				type="mult"	min="0.0037"			/>
		<spell_power_yrden				type="mult"	min="0.0037"			/>
		<critical_hit_damage_bonus		type="add"	min="0.0035"			/>
		<nonhuman_exp_bonus_when_fatal	type="add"	min="0.002"				/>
		<desc_freezingchance_mult		type="add"	min="0.0015"			/>
		<buff_apply_chance				type="add"	min="0.0015"			/>
	</ability>

	<ability name="PotP_Navigator_Growth_EWR">
		<attack_power					type="mult"	min="0.0105"			/>
		<spell_power_quen				type="mult"	min="0.0115"			/>
		<spell_power_yrden				type="mult"	min="0.0115"			/>
		<critical_hit_damage_bonus		type="add"	min="0.016"				/>
		<nonhuman_exp_bonus_when_fatal	type="add"	min="0.0056"			/>
		<desc_freezingchance_mult		type="add"	min="0.0036"			/>
		<buff_apply_chance				type="add"	min="0.0036"			/>
	</ability>

</abilities>

