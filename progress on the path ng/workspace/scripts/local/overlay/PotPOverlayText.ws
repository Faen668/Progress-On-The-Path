	keys.PushBack("items_part_mods");
	keys.PushBack("can_be_missed");
	keys.PushBack("card_details");
}

function PotPOverlay_ExportText() : string
{
	var keys	: array<string>;
	var result	: string;
	var text	: string;
	var Idx		: int;

	PotPOverlay_TextKeys_1(keys);
	PotPOverlay_TextKeys_2(keys);
	PotPOverlay_TextKeys_3(keys);

	for (Idx = 0; Idx < keys.Size(); Idx += 1)
	{
		text = GetLocStringByKeyExt("potp_ov_" + keys[Idx]);
		if (text != "" && !StrStartsWith(text, "#"))
		{
			result += "\nT|" + keys[Idx] + "|" + PotPOverlay_Clean(text);
		}
	}
	return result;
}
