//---------------------------------------------------
//-- Bestiary Definitions ---------------------------
//---------------------------------------------------
// Made by overlay/tools/gen_bestiary from the game's journal files. Don't edit by hand.

function PotP_DefineBestiary(catalog: CPotP_Catalog)
{
	PotP_DefineBestiary_1(catalog);
	PotP_DefineBestiary_2(catalog);
	PotP_DefineBestiary_3(catalog);
	PotP_DefineBestiary_4(catalog);
	PotP_DefineBestiary_5(catalog);
	PotP_DefineBestiary_6(catalog);
}

